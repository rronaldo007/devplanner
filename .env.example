# Copy to .env and fill in. docker-compose reads .env automatically.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Anthropic (optional). Per-user keys configured in Settings always win.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# If you switch to Postgres (docker compose --profile postgres up):
# DATABASE_URL=postgres://devplanner:devplanner@db:5432/devplanner
