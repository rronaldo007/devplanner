# Copy to .env and fill in. docker-compose reads .env automatically.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Anthropic (optional). Per-user keys configured in Settings always win.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OSS / OpenAI-compatible fallback (optional). Used when Claude is unavailable
# (no key or out of credits) before degrading to templates. Works with Ollama
# (local OR a remote host), OpenAI, or any OpenAI-compatible provider.
#   Ollama (remote "shadow PC"): OSS_BASE_URL=http://192.168.1.50:11434/v1
#   Ollama (local):              OSS_BASE_URL=http://localhost:11434/v1
#   OpenAI:                      OSS_BASE_URL=https://api.openai.com/v1
# Set BASE_URL + MODEL to enable. OSS_API_KEY is ignored by Ollama but required
# by OpenAI; defaults to a placeholder when blank.
OSS_BASE_URL=
OSS_MODEL=
OSS_API_KEY=

# If you switch to Postgres (docker compose --profile postgres up):
# DATABASE_URL=postgres://devplanner:devplanner@db:5432/devplanner
